# Copy to .env.local and fill in. .env.local is git ignored.

# Supabase project. Both of these are safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Ignores row level security, so it must never reach the client.
# Used to create staff logins, which have to be written into auth.users.
SUPABASE_SERVICE_ROLE_KEY=

# Initial password for the three seeded demo accounts. At least 12 characters.
# Only read by scripts/seed-staff.mjs.
DEMO_STAFF_PASSWORD=

# Which university the demo staff are seeded into. Defaults to northfield.
DEMO_UNIVERSITY_CODE=northfield

# The Ed25519 key this dashboard signs student cards with.
#
# Run `npm run key:generate` to create one. It registers the public half in
# issuer_keys, rotates whatever key was active before so that cards already
# issued keep verifying, and prints these two lines once.
#
# PROTOTYPE ONLY. An environment variable is readable by anyone with dashboard
# access. Whoever holds this key can mint unlimited perfect university IDs, so
# it must be replaced by a KMS before a real student is issued a card.
DEMO_SIGNING_KEY_KID=
DEMO_SIGNING_KEY_PRIVATE_JWK=

# Whether the scan console accepts a student number typed by hand as well as a
# scanned QR code. A typed number is only looked up on the register, so it
# proves the number exists rather than that the card is genuine, and every
# event recorded that way says so. Set to false to require a signature.
ALLOW_PRINTED_NUMBER_SCAN=true
